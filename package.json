{
  "name": "lista-compra-cloudflare",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply lista-compra --local",
    "db:remote": "wrangler d1 migrations apply lista-compra --remote"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@cloudflare/workers-types": "^5.20261116.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.0",
    "wrangler": "^4.48.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
